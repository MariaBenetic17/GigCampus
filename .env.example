# GigCampus Environment Configuration Example
# Copy this file to .env or export these variables in your terminal

# Spring Profile ('mysql' for production MySQL, 'dev' for local H2/MySQL dev)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gigcampus
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Port
SERVER_PORT=8080

# Initial Admin Bootstrap Configuration (Used to bootstrap the initial admin safely)
ADMIN_BOOTSTRAP_EMAIL=admin@gigcampus.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin2026!
ADMIN_BOOTSTRAP_NAME=GigCampus Admin
ADMIN_BOOTSTRAP_PHONE=9876543210
